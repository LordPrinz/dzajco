# Copy to .dev.vars for local `wrangler dev`. .dev.vars is the only local secrets source:
# .env files are ignored by the Worker (CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false). Never commit real values.

# Secret pepper used to hash link secret keys. Set in production with `wrangler secret put SECRET_PEPPER`.
SECRET_PEPPER=

# Cloudflare account id used by the Analytics Engine SQL API.
CF_ACCOUNT_ID=

# API token with the "Account Analytics: Read" permission. Leave empty locally to skip SQL API queries.
CF_AE_TOKEN=
