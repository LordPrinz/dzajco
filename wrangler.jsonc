{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dzajco",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  // Pinned off so `wrangler deploy` cannot turn them back on. Both hosts bypass the zone WAF rule and the Cache API.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dzajco",
      "database_id": "6e5a466f-0a3f-44cd-b06f-c61c870bcc7b",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "dzajco_visits" }],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_DELETE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_STATS", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_REDIRECT", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Local default. `bun run deploy` overrides it with the PUBLIC_ORIGIN from the environment (docs/DEPLOYMENT.md).
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "ROLLUP_MAX_PAGES": "10",
    "AE_FRESH_TTL": "300",
    "SECRET_PEPPER_VERSION": "1",
    // Account id for the Analytics Engine SQL API; set per deployment (docs/DEPLOYMENT.md).
    "CF_ACCOUNT_ID": "e72ff677d31ee953dd1dff657b75d18c",
    // Address shown as a "Report abuse" mailto link on 404/410 pages. Empty hides the link.
    "ABUSE_EMAIL": "dzajlopmentdev@gmail.com",
    // Cloudflare Web Analytics token (32 hex chars or a dashed UUID). Empty omits the beacon script entirely.
    "CF_ANALYTICS_TOKEN": ""
  },
  // Dev environment on test.dzaj.de (docs/DEPLOYMENT.md). Deploy with `bun run deploy:dev`. Bindings and
  // vars are not inherited, so each one is repeated here with its own resource.
  "env": {
    "dev": {
      "name": "dzajco-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "test.dzaj.de", "custom_domain": true }],
      "observability": { "enabled": true },
      "assets": { "directory": "./public" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dzajco-dev",
          "database_id": "7e2823b2-d0fa-4c79-89c6-7d0dc14e7e31",
          "migrations_dir": "migrations"
        }
      ],
      "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "dzajco_visits_dev" }],
      "ratelimits": [
        { "name": "RL_CREATE", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_DELETE", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_STATS", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_REDIRECT", "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } }
      ],
      "triggers": { "crons": ["0 * * * *"] },
      "vars": {
        "PUBLIC_ORIGIN": "https://test.dzaj.de",
        "AE_DATASET": "dzajco_visits_dev",
        "ROLLUP_MAX_PAGES": "10",
        "AE_FRESH_TTL": "300",
        "SECRET_PEPPER_VERSION": "1",
        "CF_ACCOUNT_ID": "e72ff677d31ee953dd1dff657b75d18c",
        "ABUSE_EMAIL": "dzajlopmentdev@gmail.com",
        "CF_ANALYTICS_TOKEN": ""
      }
    }
  }
}
