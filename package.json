{
  "name": "dzajco",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "deploy": "bun run check && bun run typecheck && bun run test && bun run test:worker && wrangler deploy",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.bun.json",
    "test": "bun test ./src ./scripts",
    "test:worker": "vitest run",
    "types": "wrangler types --env-file .env.example",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
