# Copy to .dev.vars for local `wrangler dev`. .dev.vars is the only local secrets source:
# .env files are ignored by the Worker (CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false). Never commit real values.

# Pepper for hashing link secret keys, one per version. SECRET_PEPPER_VERSION (a wrangler var) selects the
# version used for new keys; keep older peppers set so existing keys still verify. Set in production with
# `wrangler secret put SECRET_PEPPER_V1`.
SECRET_PEPPER_V1=

# API token with the "Account Analytics: Read" permission, used with the CF_ACCOUNT_ID var. Leave empty
# locally: the Worker then skips SQL API queries and fresh stats are empty.
CF_AE_TOKEN=
