{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dzajco",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  // Pinned off so `wrangler deploy` cannot turn them back on. Both hosts bypass the zone WAF rule and the Cache API.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dzajco",
      "database_id": "6e5a466f-0a3f-44cd-b06f-c61c870bcc7b",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "dzajco_visits" }],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_DELETE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_STATS", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_REDIRECT", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Local default. `bun run deploy` overrides it with the PUBLIC_ORIGIN from the environment (docs/DEPLOYMENT.md).
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "ROLLUP_MAX_PAGES": "10",
    "AE_FRESH_TTL": "300",
    "SECRET_PEPPER_VERSION": "1",
    // Account id for the Analytics Engine SQL API; set per deployment (docs/DEPLOYMENT.md).
    "CF_ACCOUNT_ID": "e72ff677d31ee953dd1dff657b75d18c",
    // Address shown as a "Report abuse" mailto link on 404/410 pages. Empty hides the link.
    "ABUSE_EMAIL": "dzajlopmentdev@gmail.com",
    // Cloudflare Web Analytics token (32 hex chars or a dashed UUID). Empty omits the beacon script entirely.
    "CF_ANALYTICS_TOKEN": ""
  }
}
