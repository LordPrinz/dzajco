{
  "name": "dzajco",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun run build:client && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "deploy": "bun run check && bun run typecheck && bun run test && bun run test:worker && bun run build:client && bun run check:size && wrangler deploy --env=\"\" --var PUBLIC_ORIGIN:${PUBLIC_ORIGIN:?set PUBLIC_ORIGIN, for example https://dzaj.de}",
    "deploy:dev": "bun run check && bun run typecheck && bun run test && bun run test:worker && bun run build:client && bun run check:size && wrangler deploy --env dev",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.bun.json && tsc --noEmit -p tsconfig.client.json",
    "test": "bun test ./src ./scripts",
    "test:worker": "vitest run",
    "test:e2e": "playwright test",
    "test:lhci": "lhci autorun",
    "types": "wrangler types --env-file .env.example",
    "prepare": "husky",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "gh:setup": "bun scripts/gh/setup.ts",
    "gh:setup-repo": "bun scripts/gh/setup-repo.ts",
    "gh:setup-project": "bun scripts/gh/setup-project.ts",
    "gh:sync": "bun scripts/gh/sync-project.ts",
    "gh:create-issues": "bun scripts/gh/create-issues.ts",
    "test:coverage": "bun test ./src --coverage --coverage-reporter=lcov && bun scripts/ci/coverage.ts",
    "admin:block": "bun scripts/admin/block.ts",
    "migrate:mongo": "bun scripts/migrate/mongo-to-d1.ts",
    "build:client": "bun build src/client/*.ts --outdir public/assets --minify --splitting --target browser",
    "check:size": "bun scripts/ci/size.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "trustedDependencies": [
    "esbuild",
    "fsevents",
    "workerd"
  ],
  "dependencies": {
    "hono": "4.13.18",
    "valibot": "1.5.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/leaflet": "1.9.22",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "mongodb": "7.8.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
